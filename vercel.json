{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [{ "source": "/storybook", "destination": "/storybook/", "permanent": false }],
  "rewrites": [
    { "source": "/", "destination": "/playbook" },
    { "source": "/favicon.ico", "destination": "/icons/oxagen-favicon.ico" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
