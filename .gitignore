.venv/
__pycache__/
*.pyc

# Agent worktrees carry their own checkouts and virtualenvs. This repo is
# public; nothing from a scratch worktree belongs in it.
.claude/worktrees/
.DS_Store

# Prospect names for the message registry's blocklist. Tracking them would
# publish them in this public repo.
messages/rules/*.local.txt

# Aeonik is licensed from CoType Foundry, not open-licensed like Space Grotesk.
# The webfonts are dropped in locally and never committed to this public repo.
fonts/aeonik-*.woff2
fonts/Aeonik*

# Oxagen: this machine's link to a workspace; never committed.
.oxagen/workspace.json
.stella/private/

# The component kit in ui/. Installs, builds, and the design-sync scratch space
# stay local. CI builds Storybook into ui/storybook-static/ and the deploy job
# copies it to /storybook/ at the root for Vercel.
node_modules/
ui/dist/
ui/storybook-static/
ui/design-system/
/storybook/
ui/.design-sync/sb-reference/
ui/.design-sync/learnings/
ui/.design-sync/.cache/
ui/.design-sync/previews/
ui/.design-sync/node_modules/
ui/.design-sync/*.log
