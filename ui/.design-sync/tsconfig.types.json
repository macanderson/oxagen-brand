{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "../dist/types",
    "rootDir": "../src",
    "skipLibCheck": true
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": [
    "../src/**/*.stories.tsx",
    "../src/**/*.test.tsx",
    "../src/**/*.test.ts",
    "../src/pages/**"
  ]
}
