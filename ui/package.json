{
  "name": "@oxagen/ui",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./lib/motion": "./src/lib/motion.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "build:types": "tsc -p .design-sync/tsconfig.types.json",
    "build:design-system": "pnpm build:types && node scripts/build-design-system.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@phosphor-icons/react": "2.1.10",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.4.1",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "2.1.9",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "2.1.9"
  }
}
