{
  "about": "Every repo that ships Oxagen or Stella, and every live surface it serves. The fan-out workflow runs each repo's sync against the kit after a merge to main and opens a PR there. build/conformance.py checks each repo and surface. Add a repo here when it starts shipping either brand.",
  "kit": {
    "surfaces": [
      { "url": "https://brand.oxagen.cloud", "pages": ["/"] }
    ]
  },
  "consumers": [
    {
      "repo": "macanderson/oxagen",
      "sync": "node tools/scripts/sync-brand-assets.mjs --brand \"$KIT\"",
      "apt": ["librsvg2-bin"],
      "surfaces": [
        { "url": "https://oxagen.sh", "pages": ["/"] },
        { "url": "https://oxagen.app", "pages": ["/"] },
        { "url": "https://docs.oxagen.app", "pages": ["/"] }
      ]
    },
    {
      "repo": "macanderson/stella",
      "sync": "node scripts/sync-brand-assets.mjs --brand \"$KIT\"",
      "apt": [],
      "surfaces": []
    },
    {
      "repo": "macanderson/oxagen-roadmap",
      "sync": "node scripts/sync-brand.mjs --brand \"$KIT\"",
      "apt": [],
      "surfaces": [
        { "url": "https://roadmap.oxagen.cloud", "pages": ["/"] }
      ]
    },
    {
      "repo": "macanderson/oxagen-gtm",
      "sync": "node scripts/build-data.mjs --brand \"$KIT\"",
      "apt": [],
      "surfaces": [
        { "url": "https://gtm.oxagen.cloud", "pages": ["/"] }
      ]
    },
    {
      "repo": "macanderson/oxagen-survey",
      "sync": "node scripts/sync-brand.mjs --brand \"$KIT\"",
      "apt": [],
      "surfaces": [
        { "url": "https://survey.oxagen.app", "pages": ["/"] }
      ]
    }
  ]
}
