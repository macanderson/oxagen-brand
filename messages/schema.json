{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oxagenai/oxagen-brand/messages/schema.json",
  "title": "Oxagen message registry entry",
  "description": "One approved, candidate, or retired message. build/messages.py enforces these rules and the prose checks the schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "brand", "kind", "title", "audience", "clause", "surfaces", "status", "owner", "findings"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Unique, and equal to the file name without .yaml."},
    "brand": {"enum": ["oxagen", "stella"]},
    "kind": {"enum": ["headline", "eyebrow", "pitch", "section", "card", "entry-point", "rule", "proof", "pair", "email", "announcement", "ad", "glossary"]},
    "order": {"type": "integer", "description": "Position within its group on the generated page."},
    "title": {"type": "string", "minLength": 1, "description": "The line itself, or for a pitch, rule, pair, or glossary entry, its label. For an email, the subject."},
    "short": {"type": "string"},
    "long": {"type": "string"},
    "cta": {"type": "string"},
    "cta_destination": {"type": "string", "description": "What the action must lead to. Internal."},
    "kicker": {"type": "string"},
    "headline": {"$ref": "#/$defs/lines", "description": "Ad: the tall stack for the square and the portrait."},
    "wide": {"$ref": "#/$defs/lines", "description": "Ad: the same words in long lines for the landscape."},
    "short_lines": {"$ref": "#/$defs/lines", "description": "Ad: what the 300x250 carries."},
    "subline": {"type": "string"},
    "subshort": {"type": "string"},
    "picture": {"enum": ["ghost", "orbit"]},
    "scope_terms": {"$ref": "#/$defs/lines", "description": "Ad: every subline and subshort must contain one of these words, so the short form keeps its scope."},
    "before": {"type": "string", "description": "Pair: the wrong version. Exempt from word and phrase checks."},
    "after": {"type": "string", "description": "Pair: the right version."},
    "rows": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["label", "text"],
                "properties": {"label": {"type": "string"}, "text": {"type": "string"}}}
    },
    "phrases": {"$ref": "#/$defs/lines", "description": "Rule: phrases the check rejects in live copy. A phrase with a capital letter matches case-sensitively."},
    "audience": {"type": "array", "minItems": 1, "items": {"enum": ["operator", "platform", "security", "finance", "engineering", "knowledge", "investor"]}},
    "clause": {"enum": ["access", "budget", "equipment", "record", "operations", "none"]},
    "surfaces": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["candidate", "approved", "retired"]},
    "release": {"enum": ["launch", "held"]},
    "gate": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "qualifier": {"type": "string", "description": "The scope sentence every short form must preserve."},
    "evidence": {"type": "string", "description": "Launch acceptance evidence the claim needs."},
    "owner": {"type": "string", "minLength": 1},
    "review_by": {"type": "string", "format": "date"},
    "findings": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
    "replaced_by": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "retired"}}},
     "then": {"anyOf": [{"required": ["replaced_by"], "properties": {"replaced_by": {"type": "string"}}}, {"required": ["notes"]}]},
     "else": {"required": ["release", "review_by"], "not": {"required": ["replaced_by"]}}},
    {"if": {"properties": {"release": {"const": "held"}}, "required": ["release"]}, "then": {"required": ["gate"]}},
    {"if": {"properties": {"release": {"const": "launch"}}, "required": ["release"]}, "then": {"not": {"required": ["gate"]}}},
    {"if": {"properties": {"kind": {"const": "ad"}}}, "then": {"required": ["kicker", "headline", "short_lines", "cta"]}},
    {"if": {"properties": {"kind": {"const": "pair"}, "status": {"not": {"const": "retired"}}}}, "then": {"required": ["before", "after"]}},
    {"if": {"properties": {"status": {"const": "approved"}, "release": {"const": "launch"},
                           "kind": {"enum": ["headline", "eyebrow", "pitch", "section", "card", "entry-point", "proof", "email", "announcement", "ad"]}},
            "required": ["status", "release"]},
     "then": {"required": ["evidence"]}}
  ],
  "$defs": {
    "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
